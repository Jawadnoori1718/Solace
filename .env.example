# Solace — environment template.
#
# Copy to `.env.local`, which is git-ignored:
#
#   cp .env.example .env.local
#
# Every value below has a working default. A fresh checkout runs offline in
# demo mode with none of these set.

# ---------------------------------------------------------------------------
# Operating mode
# ---------------------------------------------------------------------------

# DEMO — everything runs locally against a Hardhat node. No internet needed.
# LIVE — settlement is written to Base Sepolia, so the block explorer link
#        points at a genuinely public, independently verifiable transaction.
#
# Defaults to DEMO. That is deliberate: an unconfigured checkout should work
# offline rather than fail reaching for a network it was never told about.
SOLACE_MODE=DEMO

# Exposed to the browser so the interface can label which mode it is in.
# Keep it in step with SOLACE_MODE above.
NEXT_PUBLIC_SOLACE_MODE=DEMO

# ---------------------------------------------------------------------------
# Privacy
# ---------------------------------------------------------------------------

# Salt for the HMAC that produces on-chain recipient identifiers.
#
# This is the single most security-relevant value in the project. The demo
# universe has eleven households, so an unsalted hash of a household reference
# could be brute-forced by anyone in seconds. The secret salt is what makes the
# on-chain identifier genuinely opaque.
#
# Generate one with:  openssl rand -hex 32
SOLACE_HASH_SALT=

# ---------------------------------------------------------------------------
# Anthropic API
# ---------------------------------------------------------------------------

# Used for exactly two jobs: parsing free-text council case notes into
# structured need signals, and writing the plain-English accountability report.
#
# The allocation engine does not use this key and does not call any model.
# Without a key the interface falls back to stored results and says so.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Chain
# ---------------------------------------------------------------------------

# A funded Base Sepolia testnet key, used to deploy the token and to submit
# settlements in LIVE mode. Use a throwaway key. Never a key holding real value.
DEPLOYER_PRIVATE_KEY=

# Override if the public Base Sepolia endpoint is rate-limiting.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Where the local Hardhat node listens in DEMO mode.
HARDHAT_RPC_URL=http://127.0.0.1:8545

# ---------------------------------------------------------------------------
# Stated assumptions
# ---------------------------------------------------------------------------
#
# These are assumptions, not cited statistics. They are configurable so that a
# reviewer can see exactly what rates produced the figures in the interface and
# substitute their own.

# Rate used to convert kilowatt-hours delivered into pence spent.
SOLACE_TARIFF_PENCE_PER_KWH=28

# Rate a household currently receives for exporting surplus to the grid. The
# gap between this and the tariff above is the value Solace redirects.
SOLACE_EXPORT_PENCE_PER_KWH=15

# How far a recipient may be from an exporting household and still be matched.
SOLACE_PROXIMITY_RADIUS_KM=8

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
#
# Normally left unset. The application and the Prisma CLI both default to the
# same local file, `prisma/solace.db`, so they cannot disagree about where the
# database is. Set this only to point at a scratch database.
# DATABASE_URL=file:./prisma/solace.db
