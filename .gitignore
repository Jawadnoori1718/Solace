# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# Environment
# Everything is ignored by default so that a key cannot be committed by
# accident. The committed template is the one deliberate exception.
.env*
!.env.example

# Prisma
# The SQLite database is a build artefact — `npm run db:reset` recreates it.
# Migrations are NOT ignored: they are the schema's history and belong in the
# repository. The generated client is regenerated on install.
prisma/*.db
prisma/*.db-journal
prisma/*.db-wal
prisma/*.db-shm
/src/generated/

# Hardhat
/artifacts
/cache
/typechain-types
/ignition/deployments

# Testing
/coverage

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editors and operating system noise
.DS_Store
*.pem
.vercel
